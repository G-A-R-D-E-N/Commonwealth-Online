<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main site-main--home">
        <!-- ── HERO SECTION ─────────────────────────────────────────── -->
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero__media" aria-hidden="true">
            <img
              src="/assets/images/user/zulu3.jpg"
              alt="Commonwealth Online Fallout 4 Multiplayer"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div class="hero__shade" aria-hidden="true"></div>

          <div class="hero__content">
            <div class="hero__inner">
              <div class="hero__status-ticker" aria-label="System status">
                <span class="ticker-chip ticker-chip--live">
                  <span class="pulse-dot"></span> 2 OFFICIAL SERVERS ONLINE
                </span>
                <span class="ticker-chip">FO4 AE, NG &amp; OG COMPATIBLE</span>
                <span class="ticker-chip">DIRECT IP &amp; P2P CONNECT</span>
                <span class="ticker-chip">REAL-TIME PLAYER SYNC</span>
              </div>

              <p class="hero__kicker">// FALLOUT 4 MULTIPLAYER //</p>
              <h1 id="hero-title">Fallout 4 Multiplayer, Built From The Ground Up.</h1>
              <p class="hero__tagline">
                Connect to a dedicated server and share the Commonwealth wasteland with other players. Supports Fallout 4
                Anniversary Edition (AE), Next-Gen (NG), and the original release (OG), with working dedicated servers, remote player sync and persistent shared world state.
              </p>
              <div class="hero__actions">
                <a class="co-btn co-btn--primary" href="#" data-co-link="discord">
                  <span class="btn-glyph" aria-hidden="true">&#9658;</span> Join Discord
                </a>
                <a class="co-btn co-btn--terminal" href="/servers">
                  <span class="btn-glyph" aria-hidden="true">&#9029;</span> Public Servers
                </a>
                <a class="co-btn co-btn--ghost" href="/media">
                  <span class="btn-glyph" aria-hidden="true">&#9776;</span> Browse Media
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- ── 01. OVERVIEW & ARCHITECTURE STACK ─────────────────────── -->
        <section class="site-section overview" id="overview">
          <div class="section-head">
            <p class="section-kicker">01 // SYSTEM ARCHITECTURE</p>
            <h2>Shared-world Fallout, one system at a time</h2>
          </div>
          <div class="overview__copy">
            <p>
              Commonwealth Online is a multiplayer framework for Fallout 4, supporting Anniversary Edition (AE), Next-Gen (NG),
              and the original release (OG). Multiple players connect to a dedicated server and share the Commonwealth while each
              client continues to run its own copy of the game. The framework synchronises movement, appearance,
              equipment, world time, weather and session data between those games.
            </p>
            <p>
              The project has grown well beyond a prototype: dedicated servers, live player sync, weapons &amp; equipment
              synchronization, and shared world state are all working and in active use. Independent fan project. Not affiliated
              with Bethesda or Microsoft.
            </p>
          </div>

          <div class="overview__stack-grid" aria-label="Runtime stack">
            <article class="stack-card">
              <span class="stack-card__reticle" aria-hidden="true"></span>
              <p class="stack-card__label">GAME ENGINE</p>
              <h3 class="stack-card__title">Fallout 4</h3>
              <p class="stack-card__desc">AE, NG &amp; OG (1.10.163) supported with full cross-play.</p>
            </article>

            <article class="stack-card">
              <span class="stack-card__reticle" aria-hidden="true"></span>
              <p class="stack-card__label">CLIENT RUNTIME</p>
              <h3 class="stack-card__title">F4SE Native Core</h3>
              <p class="stack-card__desc">Per-player simulation, remote proxy actors, animation hooks, and memory streaming.</p>
            </article>

            <article class="stack-card">
              <span class="stack-card__reticle" aria-hidden="true"></span>
              <p class="stack-card__label">SERVER ARCHITECTURE</p>
              <h3 class="stack-card__title">Dedicated C++ Daemon</h3>
              <p class="stack-card__desc">External dedicated server over UDP, plus Steam P2P hosting from inside the game.</p>
            </article>

            <article class="stack-card">
              <span class="stack-card__reticle" aria-hidden="true"></span>
              <p class="stack-card__label">USER INTERFACE</p>
              <h3 class="stack-card__title">PrismaUI Remastered</h3>
              <p class="stack-card__desc">Modular Pip-Boy tactical HUD, custom server browser, and gamepad integration.</p>
            </article>

            <article class="stack-card stack-card--highlight">
              <span class="stack-card__reticle" aria-hidden="true"></span>
              <p class="stack-card__label">SYSTEM STATUS</p>
              <h3 class="stack-card__title">Active &amp; Functional</h3>
              <p class="stack-card__desc">Dedicated servers, actor sync, apparel, weapons, and time/weather in active play.</p>
            </article>
          </div>
        </section>

        <!-- ── 02. COMPATIBILITY & REQUIREMENTS ──────────────────────── -->
        <section class="site-section requirements" id="requirements">
          <div class="section-head">
            <p class="section-kicker">02 // VERSION COMPATIBILITY</p>
            <h2>AE, NG &amp; OG Supported — Full Cross-Play</h2>
          </div>
          <p class="requirements__lead">
            Commonwealth Online runs across all three major Fallout 4 release targets: Anniversary Edition (AE),
            Next-Gen (NG), and the original release (OG). Players connect to the same dedicated servers with
            seamless cross-play between versions.
          </p>

          <div class="requirements__grid">
            <article class="compat-card">
              <header class="compat-card__header">
                <span class="compat-badge">SUPPORTED EDITION</span>
                <h3>Anniversary Edition (AE)</h3>
              </header>
              <p>Full support for the Fallout 4 Anniversary Edition release. Synchronized dedicated server networking, F4SE native hooks, and modern Creation Club integration.</p>
            </article>

            <article class="compat-card">
              <header class="compat-card__header">
                <span class="compat-badge">SUPPORTED EDITION</span>
                <h3>Next-Gen Update (NG)</h3>
              </header>
              <p>Full support for the modern Next-Gen engine builds across Steam and GOG. Native memory management, widescreen interface fixes, and cross-play.</p>
            </article>

            <article class="compat-card">
              <header class="compat-card__header">
                <span class="compat-badge">SUPPORTED EDITION</span>
                <h3>Original Release (OG / v1.10.163)</h3>
              </header>
              <p>Full backward compatibility for the classic pre-next-gen runtime. Play alongside friends running AE or NG with zero friction.</p>
            </article>

            <article class="compat-card compat-card--info">
              <header class="compat-card__header">
                <span class="compat-badge compat-badge--green">MODULAR ASSETS</span>
                <h3>Zero DLC or CC Requirements</h3>
              </header>
              <p>DLC, mods, and Creation Club content are strictly optional. Players without expansions play freely with peers who have them installed.</p>
            </article>
          </div>
        </section>

        <!-- ── 03. FEATURES & CAPABILITIES ───────────────────────────── -->
        <section class="site-section features" id="features">
          <div class="section-head">
            <p class="section-kicker">03 // CAPABILITIES &amp; SUBSYSTEMS</p>
            <h2>Current, active and planned systems</h2>
          </div>

          <!-- SUBSECTION: OPERATIONAL -->
          <div class="feature-deck">
            <div class="feature-deck__header">
              <span class="status-chip status-chip--active">&#9679; OPERATIONAL</span>
              <h3 class="feature-deck__title">Current &amp; Working Systems</h3>
            </div>
            <div class="feature-cards-grid">
              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">NETWORKING</span>
                  <h4>Dedicated Multiplayer Servers</h4>
                </header>
                <p>External dedicated server daemon with multiple concurrent clients, world-state sync, JSON config and local or remote hosting.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">PLAYERS</span>
                  <h4>See Other Players Live</h4>
                </header>
                <p>Runtime proxy actors with synchronised 3D position, rotation, cell and exterior worldspace transitions.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">LOCOMOTION</span>
                  <h4>Movement &amp; Animation</h4>
                </header>
                <p>Idle and movement states, sprinting, sneaking, jumping, weapon-drawn states, and precision teleports.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">APPEARANCE</span>
                  <h4>Character Appearance Sync</h4>
                </header>
                <p>Body morphs, tints, hair, head parts, facial sliders and versioned optional character appearance data.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">EQUIPMENT</span>
                  <h4>Clothing &amp; Armor Slots</h4>
                </header>
                <p>Equipped apparel mirrored across tracked slots, including live equip changes while standing still.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">COMBAT</span>
                  <h4>Ranged Weapon Sync</h4>
                </header>
                <p>Right-hand weapons with local form resolution, proxy equipping, and drawn/holstered weapon states.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">ENVIRONMENT</span>
                  <h4>Shared Time &amp; Weather</h4>
                </header>
                <p>In-game timescale, days passed, exterior weather conditions, and instant resync after menus and load screens.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">BROWSER</span>
                  <h4>Tactical Server Browser</h4>
                </header>
                <p>Direct connect, browsable entries, LAN discovery, favourites, live ping, and gamepad navigation support.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">INTERFACE</span>
                  <h4>Custom PrismaUI Menus</h4>
                </header>
                <p>HTML/CSS Pip-Boy HUD menus with multiplayer access, embedded browser, settings, and input capture.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">PROFILES</span>
                  <h4>Server-Based Characters</h4>
                </header>
                <p>Per-server saves, in-game character creation and profile binding on reconnect.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">TOOLING</span>
                  <h4>Hosting &amp; Dev Tooling</h4>
                </header>
                <p>CLI server, graphical dev server, simulated fake clients, weather controls, and deployment scripts.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">ADMINISTRATION</span>
                  <h4>In-Game Admin Console</h4>
                </header>
                <p>Dedicated in-game administration overlay with player actions, IP and profile bans, server commands, faction controls, and runtime script management.</p>
              </article>

              <article class="feature-card">
                <header class="feature-card__head">
                  <span class="feature-tag">MODERATION</span>
                  <h4>Player Reports &amp; Live Help</h4>
                </header>
                <p>In-game pause menu reporting system with player selection, categories, rate-limiting, and direct-to-admin assistance requests.</p>
              </article>
            </div>
          </div>
        </section>

