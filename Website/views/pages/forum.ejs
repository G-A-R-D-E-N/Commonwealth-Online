<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main">
        <section class="section-panel forum-hero" aria-labelledby="forum-title">
          <div class="servers-hero__head">
            <div>
              <p class="section-kicker">Community</p>
              <h1 id="forum-title">Forum</h1>
              <p class="servers-hero__desc">
                A public Commonwealth Online forum backed by Supabase, with Discord sign-in planned for posting and
                moderation. Reading stays public and does not require a GitHub account.
              </p>
            </div>
            <div class="servers-hero__actions">
              <a class="co-btn co-btn--ghost" href="#" data-co-link="discord">Join Discord</a>
            </div>
          </div>

          <p class="site-notice" role="status">
            <strong>Backend preparation is in progress.</strong>
            The public site already has the forum shell. Once a Supabase project is connected, this page can load
            public boards directly from Postgres while writes remain protected by authentication and row-level security.
          </p>
        </section>

        <section
          class="section-panel"
          aria-labelledby="forum-boards-title"
          data-forum
          data-supabase-url="<%= site.supabase?.url || "" %>"
          data-supabase-key="<%= site.supabase?.publishableKey || "" %>"
        >
          <div class="section-head">
            <p class="section-kicker">Boards</p>
            <h2 id="forum-boards-title">Community channels</h2>
          </div>

          <p class="site-notice" data-forum-status role="status">
            Supabase is not connected yet. The forum will become live after the project URL and publishable key are
            configured.
          </p>

          <ul class="feature-list" data-forum-categories hidden></ul>
        </section>

        <section class="section-panel" aria-labelledby="forum-access-title">
          <div class="section-head">
            <p class="section-kicker">Access model</p>
            <h2 id="forum-access-title">No GitHub account required</h2>
          </div>
          <ul class="feature-list">
            <li>
              <span class="feature-list__name">Public reading</span>
              <span class="feature-list__desc">Anyone can browse categories, threads, posts and reactions.</span>
            </li>
            <li>
              <span class="feature-list__name">Discord sign-in</span>
              <span class="feature-list__desc">Posting will use Supabase Auth with Discord rather than GitHub accounts.</span>
            </li>
            <li>
              <span class="feature-list__name">Database-enforced permissions</span>
              <span class="feature-list__desc">Row Level Security controls posting, editing, reactions, reports and moderation.</span>
            </li>
            <li>
              <span class="feature-list__name">Static hosting</span>
              <span class="feature-list__desc">GitHub Pages serves the UI while Supabase hosts the managed data and authentication layer.</span>
            </li>
          </ul>
        </section>
      </main>

<%- include("../partials/footer") %>

<%- include("../partials/scripts") %>
