<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main forum-main">
        <section
          class="forum-shell"
          data-forum
          data-supabase-url="<%= site.supabase?.url || "" %>"
          data-supabase-key="<%= site.supabase?.publishableKey || "" %>"
          aria-labelledby="forum-title"
        >
          <header class="forum-hero">
            <div class="forum-hero__copy">
              <p class="section-kicker">Commonwealth network</p>
              <h1 id="forum-title">Forum</h1>
              <p>Public discussions, development notes, multiplayer help, bug reports, server talk, and community feedback.</p>
            </div>
          </header>

          <div class="forum-layout">
            <aside class="forum-categories" aria-labelledby="forum-categories-title">
              <div class="forum-panel__head">
                <p class="section-kicker">Boards</p>
                <h2 id="forum-categories-title">Categories</h2>
              </div>
              <nav data-forum-categories aria-label="Forum categories"></nav>
            </aside>

            <section class="forum-discussions" aria-labelledby="forum-discussions-title">
              <div class="forum-panel__head forum-panel__head--row">
                <div>
                  <p class="section-kicker">Community</p>
                  <h2 id="forum-discussions-title" data-forum-heading>Latest discussions</h2>
                </div>
                <a class="co-btn co-btn--ghost" href="/account/" data-forum-signin>Sign in</a>
              </div>

              <form class="forum-compose" data-forum-compose hidden>
                <label>
                  <span>Category</span>
                  <select name="category_id" data-forum-compose-category required></select>
                </label>
                <label>
                  <span>Title</span>
                  <input name="title" type="text" minlength="3" maxlength="160" required />
                </label>
                <label>
                  <span>Post</span>
                  <textarea name="body" rows="5" minlength="1" maxlength="12000" required></textarea>
                </label>
                <div class="forum-compose__actions">
                  <button class="co-btn co-btn--primary" type="submit">Start discussion</button>
                </div>
              </form>

              <div class="forum-thread-tools">
                <label class="forum-thread-search">
                  <span>Search discussions</span>
                  <input type="search" data-forum-search maxlength="160" autocomplete="off" placeholder="Search titles" />
                </label>
              </div>

              <p class="forum-status" data-forum-compose-status role="status" hidden></p>
              <p class="forum-status" data-forum-status role="status">Loading forum…</p>
              <div class="forum-thread-list" data-forum-threads hidden></div>
              <div class="forum-pagination" data-forum-pagination hidden>
                <button class="co-btn co-btn--ghost" type="button" data-forum-prev>Previous</button>
                <span data-forum-page></span>
                <button class="co-btn co-btn--ghost" type="button" data-forum-next>Next</button>
              </div>
            </section>
          </div>
        </section>
      </main>

<%- include("../partials/footer") %>
<%- include("../partials/scripts") %>
