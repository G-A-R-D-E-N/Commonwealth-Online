<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main">
        <section class="section-panel repo-hero" aria-labelledby="repo-title">
          <div class="repo-hero__head">
            <div>
              <p class="repo-hero__path" id="repo-full-name"><%= site.gitea.owner %> / <%= site.gitea.repo %></p>
              <h1 id="repo-title"><%= site.gitea.repo %></h1>
              <p class="repo-hero__desc repo-hero__desc--loading" id="repo-description">
                <span class="repo-skel-line repo-skel-line--lg" aria-hidden="true"></span>
                <span class="repo-skel-line repo-skel-line--md" aria-hidden="true"></span>
                <span class="visually-hidden">Loading repository metadata…</span>
              </p>
            </div>
            <div class="repo-hero__actions">
              <a
                class="co-btn co-btn--primary"
                id="repo-open-gitea"
                href="<%= site.gitea.base %>/<%= site.gitea.owner %>/<%= site.gitea.repo %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                Open on Gitea
              </a>
              <button class="co-btn co-btn--ghost" type="button" id="repo-copy-clone" hidden>
                Copy Clone URL
              </button>
            </div>
          </div>

          <ul class="repo-stats is-loading" id="repo-stats" aria-label="Repository statistics" aria-busy="true">
            <li><span>BRANCH</span><strong id="stat-branch"><span class="repo-skel-line repo-skel-line--sm" aria-hidden="true"></span></strong></li>
            <li><span>LANGUAGE</span><strong id="stat-language"><span class="repo-skel-line repo-skel-line--sm" aria-hidden="true"></span></strong></li>
            <li><span>COMMITS</span><strong id="stat-commits"><span class="repo-skel-line repo-skel-line--sm" aria-hidden="true"></span></strong></li>
            <li><span>BRANCHES</span><strong id="stat-branches"><span class="repo-skel-line repo-skel-line--sm" aria-hidden="true"></span></strong></li>
            <li><span>WATCHERS</span><strong id="stat-watchers"><span class="repo-skel-line repo-skel-line--sm" aria-hidden="true"></span></strong></li>
            <li><span>UPDATED</span><strong id="stat-updated"><span class="repo-skel-line repo-skel-line--sm" aria-hidden="true"></span></strong></li>
          </ul>

          <div class="repo-clone" id="repo-clone" hidden>
            <label class="repo-clone__label" for="repo-clone-input">HTTPS</label>
            <input class="repo-clone__input" id="repo-clone-input" type="text" readonly value="" />
          </div>

          <p class="repo-status is-busy" id="repo-status" role="status">
            <span class="status-pulse">Connecting to Gitea</span><span class="blink-cursor" aria-hidden="true"></span>
          </p>
        </section>

        <div class="repo-grid">
          <section class="section-panel repo-panel repo-panel--fold is-collapsed" data-repo-fold aria-labelledby="repo-files-title">
            <div class="section-head repo-fold__head">
              <div class="repo-fold__titles">
                <h2 id="repo-files-title">Files</h2>
              </div>
              <button
                type="button"
                class="repo-fold__toggle"
                aria-expanded="false"
                aria-controls="repo-files-fold"
                data-repo-fold-toggle
              >
                <span class="visually-hidden">Show files</span>
                <span class="repo-fold__chevron" aria-hidden="true"></span>
              </button>
            </div>
            <div class="repo-fold__panel" id="repo-files-fold">
              <div class="repo-fold__panel-inner">
                <nav class="repo-breadcrumb" id="repo-breadcrumb" aria-label="Path">
                  <span class="repo-skel-line repo-skel-line--xs" aria-hidden="true"></span>
                </nav>
                <div class="repo-files" id="repo-files" aria-busy="true">
                  <div class="repo-loading" data-loading="files">
                    <p class="repo-loading__label">
                      <span class="status-pulse">Syncing file tree</span><span class="blink-cursor" aria-hidden="true"></span>
                    </p>
                    <div class="repo-file-list repo-file-list--skel" aria-hidden="true">
                      <div class="repo-skel-row"><span class="repo-skel-icon"></span><span class="repo-skel-line repo-skel-line--md"></span><span class="repo-skel-line repo-skel-line--xs"></span></div>
                      <div class="repo-skel-row"><span class="repo-skel-icon"></span><span class="repo-skel-line repo-skel-line--lg"></span><span class="repo-skel-line repo-skel-line--xs"></span></div>
                      <div class="repo-skel-row"><span class="repo-skel-icon"></span><span class="repo-skel-line repo-skel-line--sm"></span><span class="repo-skel-line repo-skel-line--xs"></span></div>
                      <div class="repo-skel-row"><span class="repo-skel-icon"></span><span class="repo-skel-line repo-skel-line--md"></span><span class="repo-skel-line repo-skel-line--xs"></span></div>
                      <div class="repo-skel-row"><span class="repo-skel-icon"></span><span class="repo-skel-line repo-skel-line--lg"></span><span class="repo-skel-line repo-skel-line--xs"></span></div>
                      <div class="repo-skel-row"><span class="repo-skel-icon"></span><span class="repo-skel-line repo-skel-line--sm"></span><span class="repo-skel-line repo-skel-line--xs"></span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="section-panel repo-panel repo-panel--fold is-collapsed" data-repo-fold aria-labelledby="repo-commits-title">
            <div class="section-head repo-fold__head">
              <div class="repo-fold__titles">
                <h2 id="repo-commits-title">Recent commits</h2>
              </div>
              <button
                type="button"
                class="repo-fold__toggle"
                aria-expanded="false"
                aria-controls="repo-commits-fold"
                data-repo-fold-toggle
              >
                <span class="visually-hidden">Show recent commits</span>
                <span class="repo-fold__chevron" aria-hidden="true"></span>
              </button>
            </div>
            <div class="repo-fold__panel" id="repo-commits-fold">
              <div class="repo-fold__panel-inner">
                <ol class="repo-commits" id="repo-commits" aria-label="Recent commits" aria-busy="true">
                  <li class="repo-loading" data-loading="commits">
                    <p class="repo-loading__label">
                      <span class="status-pulse">Fetching commits</span><span class="blink-cursor" aria-hidden="true"></span>
                    </p>
                    <div class="repo-skel-commits" aria-hidden="true">
                      <div class="repo-skel-commit"><span class="repo-skel-line repo-skel-line--xs"></span><span class="repo-skel-line repo-skel-line--lg"></span><span class="repo-skel-line repo-skel-line--sm"></span></div>
                      <div class="repo-skel-commit"><span class="repo-skel-line repo-skel-line--xs"></span><span class="repo-skel-line repo-skel-line--md"></span><span class="repo-skel-line repo-skel-line--sm"></span></div>
                      <div class="repo-skel-commit"><span class="repo-skel-line repo-skel-line--xs"></span><span class="repo-skel-line repo-skel-line--lg"></span><span class="repo-skel-line repo-skel-line--sm"></span></div>
                      <div class="repo-skel-commit"><span class="repo-skel-line repo-skel-line--xs"></span><span class="repo-skel-line repo-skel-line--md"></span><span class="repo-skel-line repo-skel-line--sm"></span></div>
                    </div>
                  </li>
                </ol>
                <button class="co-btn co-btn--ghost repo-commits__more" type="button" id="repo-commits-more" hidden>
                  See more
                </button>
              </div>
            </div>
          </section>
        </div>

        <section class="section-panel repo-panel repo-docs" id="repo-readme-section" aria-labelledby="repo-readme-title">
          <aside class="repo-docs__sidebar">
            <div class="repo-docs__sidebar-section">
              <div class="repo-doc-menu repo-doc-menu--skel" id="repo-doc-tabs-skel" aria-hidden="true">
                <span class="repo-skel-line repo-skel-line--md"></span>
                <span class="repo-skel-line repo-skel-line--sm"></span>
                <span class="repo-skel-line repo-skel-line--md"></span>
                <span class="repo-skel-line repo-skel-line--sm"></span>
                <span class="repo-skel-line repo-skel-line--md"></span>
              </div>
              <div
                class="repo-doc-menu"
                id="repo-doc-tabs"
                role="tablist"
                aria-label="Root documentation files"
                aria-orientation="vertical"
                hidden
              ></div>
            </div>

            <nav class="repo-outline" id="repo-outline" aria-label="Document outline" hidden>
              <p class="repo-outline__label">OUTLINE</p>
              <ol class="repo-outline__list" id="repo-outline-list"></ol>
            </nav>
          </aside>

          <div class="repo-docs__content">
            <div class="section-head">
              <h2 id="repo-readme-title">README.md</h2>
            </div>
            <div class="repo-readme-stage">
              <article class="repo-readme" id="repo-readme" role="tabpanel" aria-labelledby="repo-readme-title" aria-busy="true">
                <div class="repo-loading" data-loading="readme">
                  <p class="repo-loading__label">
                    <span class="status-pulse">Loading document</span><span class="blink-cursor" aria-hidden="true"></span>
                  </p>
                  <div class="repo-skel-doc" aria-hidden="true">
                    <span class="repo-skel-line repo-skel-line--title"></span>
                    <span class="repo-skel-line repo-skel-line--lg"></span>
                    <span class="repo-skel-line repo-skel-line--lg"></span>
                    <span class="repo-skel-line repo-skel-line--md"></span>
                    <span class="repo-skel-line repo-skel-line--lg"></span>
                    <span class="repo-skel-line repo-skel-line--sm"></span>
                    <span class="repo-skel-line repo-skel-line--lg"></span>
                    <span class="repo-skel-line repo-skel-line--md"></span>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="section-panel repo-panel" id="repo-file-section" hidden aria-labelledby="repo-file-title">
          <div class="section-head repo-file-head">
            <div>
              <h2 id="repo-file-title">File</h2>
            </div>
            <a class="co-btn co-btn--ghost" id="repo-file-raw" href="#" target="_blank" rel="noopener noreferrer">
              View Raw
            </a>
          </div>
          <pre class="repo-file-view"><code id="repo-file-content"></code></pre>
        </section>

        <section class="section-panel repo-panel" aria-labelledby="repo-langs-title">
          <div class="section-head">
            <h2 id="repo-langs-title">Language breakdown</h2>
          </div>
          <div class="repo-langs" id="repo-langs" aria-busy="true">
            <div class="repo-loading" data-loading="langs">
              <p class="repo-loading__label">
                <span class="status-pulse">Scanning languages</span><span class="blink-cursor" aria-hidden="true"></span>
              </p>
              <div class="repo-skel-langs" aria-hidden="true">
                <span class="repo-skel-bar"></span>
                <span class="repo-skel-line repo-skel-line--md"></span>
                <span class="repo-skel-line repo-skel-line--sm"></span>
                <span class="repo-skel-line repo-skel-line--md"></span>
              </div>
            </div>
          </div>
        </section>
      </main>

<%- include("../partials/footer") %>

<%- include("../partials/scripts") %>
