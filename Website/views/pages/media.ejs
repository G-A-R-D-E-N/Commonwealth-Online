<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main">
        <section class="section-panel media-hero" aria-labelledby="media-title">
          <div class="media-hero__head">
            <div>
              <h1 id="media-title">Media gallery</h1>
              <p class="media-hero__desc">
                In-game screenshots from Commonwealth Online development on Fallout 4. Anniversary Edition (AE), Next-Gen (NG),
                and the original release (OG) are all supported. Live player sync, weapons &amp; equipment synchronization, community characters
                and custom interface work. No DLC, mods or Creation Club content required unless other players have
                them.
              </p>
            </div>
            <div class="media-hero__actions">
              <a class="co-btn co-btn--ghost" href="/">Back to home</a>
            </div>
          </div>
        </section>

        <section class="section-panel media-gallery-panel" id="remote-players" aria-labelledby="remote-players-title">
          <div class="section-head">
            <h2 id="remote-players-title">Remote Players</h2>
          </div>
          <div class="media-grid">
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Sanctuary Bridge Meeting">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/image23.png"
                    alt="Two players meeting on the Sanctuary bridge in Commonwealth Online"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Sanctuary Bridge Meeting</span>
                <span class="preview-window__description">Two connected players meet on the Sanctuary bridge with active nameplate and interaction prompt.</span>
              </figcaption>
            </figure>
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Wasteland Exploration">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/image99.png"
                    alt="Two players exploring the Commonwealth wasteland in real-time"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Wasteland Exploration</span>
                <span class="preview-window__description">Two operatives in duster coats navigating exterior worldspaces in synchronized multiplayer.</span>
              </figcaption>
            </figure>
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Multiplayer V.A.T.S. Targeting">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/image999.png"
                    alt="Real-time V.A.T.S. targeting on remote player KEV-0"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Multiplayer V.A.T.S. Targeting</span>
                <span class="preview-window__description">Real-time V.A.T.S. lock-on with synchronized limb hit chances on remote players.</span>
              </figcaption>
            </figure>
          </div>
        </section>

        <section class="section-panel media-gallery-panel" id="equipment-sync" aria-labelledby="equipment-sync-title">
          <div class="section-head">
            <h2 id="equipment-sync-title">Framework &amp; Systems</h2>
          </div>
          <div class="media-grid">
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Commonwealth Online Wallpaper">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/zulu3.jpg"
                    alt="Commonwealth Online Wallpaper Montage"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Commonwealth Online Wallpaper</span>
                <span class="preview-window__description">Official widescreen Fallout background montage for Commonwealth Online.</span>
              </figcaption>
            </figure>
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: C.A.M.P. 3D Fabrication">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/image-23.png"
                    alt="C.A.M.P. 3D Fabrication Workstation printing mini nuke"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">C.A.M.P. 3D Fabrication</span>
                <span class="preview-window__description">Vault-Tec C.A.M.P. workstation 3D model printing tactical munitions.</span>
              </figcaption>
            </figure>
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Client Launcher">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/image9.png"
                    alt="Commonwealth Online Client Launcher and Status Console"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Client Launcher Console</span>
                <span class="preview-window__description">Standalone client launcher verifying game runtime, F4SE native core, and PrismaUI.</span>
              </figcaption>
            </figure>
          </div>
        </section>

        <section class="section-panel media-gallery-panel" id="community-players" aria-labelledby="community-players-title">
          <div class="section-head">
            <h2 id="community-players-title">Concept Backgrounds &amp; Operatives</h2>
          </div>
          <div class="media-grid">
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Commonwealth Concept Backgrounds">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/user/zulu2.png"
                    alt="Commonwealth Online Concept Backgrounds 6-panel study"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Commonwealth Concept Backgrounds</span>
                <span class="preview-window__description">Official Fallout 4 background panels and concept art study.</span>
              </figcaption>
            </figure>
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Synchronized Operatives">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/TwoPlayers.webp"
                    alt="Two players exploring the Commonwealth together in synchronized multiplayer"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Synchronized Operatives</span>
                <span class="preview-window__description">Two players traversing the Commonwealth ruins with synchronized gear and movement.</span>
              </figcaption>
            </figure>
            <figure class="preview-window">
              <button class="preview-window__trigger" type="button" aria-label="Enlarge: Vault Emergence">
                <span class="preview-window__screen">
                  <img
                    src="/assets/images/Vault109Exit.webp"
                    alt="Vault dweller emerging into the shared persistent Commonwealth worldspace"
                    loading="eager"
                    decoding="sync"
                  />
                </span>
              </button>
              <figcaption>
                <span class="preview-window__name">Vault Emergence</span>
                <span class="preview-window__description">Vault dweller entering the persistent multiplayer wasteland.</span>
              </figcaption>
            </figure>
          </div>
        </section>
      </main>

<%- include("../partials/footer") %>

    <dialog class="media-lightbox" id="media-lightbox" aria-labelledby="media-lightbox-name">
      <div class="media-lightbox__panel">
        <div class="media-lightbox__chrome">
          <p class="media-lightbox__label">Enlarged view</p>
          <button class="media-lightbox__close" type="button" aria-label="Close enlarged image">
            <span class="media-lightbox__close-glyph" aria-hidden="true">&times;</span>
            <span class="media-lightbox__close-text">Close</span>
          </button>
        </div>
        <figure class="media-lightbox__figure">
          <div class="media-lightbox__image-wrap">
            <img class="media-lightbox__image" id="media-lightbox-image" alt="" />
          </div>
          <figcaption class="media-lightbox__caption">
            <span class="media-lightbox__name" id="media-lightbox-name"></span>
            <span class="media-lightbox__description" id="media-lightbox-description"></span>
          </figcaption>
        </figure>
      </div>
    </dialog>

<%- include("../partials/scripts") %>
