<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main factions-main">
        <section
          class="faction-shell"
          data-faction-review
          data-supabase-url="<%= site.supabase?.url || "" %>"
          data-supabase-key="<%= site.supabase?.publishableKey || "" %>"
          aria-labelledby="faction-review-title"
        >
          <header class="faction-profile-head">
            <div>
              <p class="section-kicker">Admin review</p>
              <h1 id="faction-review-title">Faction applications</h1>
              <p class="servers-hero__desc">Review proposed factions before they are created in Commonwealth Online.</p>
            </div>
            <a class="co-btn co-btn--ghost" href="/factions/">Back to factions</a>
          </header>

          <p class="site-notice" data-faction-review-status role="status">Checking administrator access…</p>

          <div class="faction-review-toolbar" data-faction-review-toolbar hidden>
            <label class="profile-field faction-review-filter">
              <span>Show applications</span>
              <select data-faction-review-filter>
                <option value="open">Open queue</option>
                <option value="submitted">Submitted</option>
                <option value="reviewing">In review</option>
                <option value="changes_requested">Changes requested</option>
                <option value="closed">Closed</option>
                <option value="all">All</option>
              </select>
            </label>
          </div>

          <div class="faction-review-list" data-faction-review-list hidden>
            <p class="account-help">Loading faction applications…</p>
          </div>
        </section>
      </main>

<%- include("../partials/footer") %>
<%- include("../partials/scripts") %>
