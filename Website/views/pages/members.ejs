<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main members-main">
        <section
          class="members-page"
          data-members
          data-supabase-url="<%= site.supabase?.url || "" %>"
          data-supabase-key="<%= site.supabase?.publishableKey || "" %>"
          aria-labelledby="members-title"
        >
          <header class="members-hero">
            <div class="members-hero__copy">
              <p class="section-kicker">Commonwealth Online</p>
              <h1 id="members-title">Members</h1>
              <p>Browse public player profiles across the Commonwealth.</p>
            </div>
          </header>

          <div class="members-menu">
            <div class="members-menu__topline">
              <span>Public directory</span>
              <span><strong data-members-count>—</strong> members</span>
            </div>

            <label class="members-search">
              <span>Search members</span>
              <input type="search" data-members-search placeholder="Search by username" autocomplete="off" />
            </label>

            <p class="members-state" data-members-status data-tone="loading" role="status">Loading members…</p>
            <div class="members-grid" data-members-list hidden></div>
          </div>
        </section>
      </main>

<%- include("../partials/footer") %>
<%- include("../partials/scripts") %>
