<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

      <main class="site-main members-main">
        <section
          class="members-shell"
          data-members
          data-supabase-url="<%= site.supabase?.url || "" %>"
          data-supabase-key="<%= site.supabase?.publishableKey || "" %>"
          aria-labelledby="members-title"
        >
          <header class="members-intro">
            <div>
              <p class="section-kicker">Community directory</p>
              <h1 id="members-title">Members</h1>
              <p>Find public player profiles, see faction affiliation, and open a member profile without digging through account pages.</p>
            </div>
            <div class="members-directory-meta" aria-live="polite">
              <strong data-members-count>—</strong>
              <span>Public profiles</span>
            </div>
          </header>

          <div class="members-toolbar">
            <label class="members-search">
              <span>Search directory</span>
              <input type="search" data-members-search placeholder="Search by username" autocomplete="off" />
            </label>
            <p class="members-toolbar__hint">Only profiles marked public are listed.</p>
          </div>

          <p class="members-state" data-members-status data-tone="loading" role="status">Loading member directory…</p>
          <div class="members-grid" data-members-list hidden></div>
        </section>
      </main>

<%- include("../partials/footer") %>
<%- include("../partials/scripts") %>
