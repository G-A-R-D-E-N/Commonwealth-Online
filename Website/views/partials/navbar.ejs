      <header class="site-header" id="top" data-co-navbar data-supabase-url="<%= site.supabase?.url || "" %>" data-supabase-key="<%= site.supabase?.publishableKey || "" %>">
        <div class="site-header__inner">
          <a class="site-brand" href="/" aria-label="Commonwealth Online Home">
            <img
              class="site-brand__logo"
              src="/assets/branding/logo.svg"
              alt="Commonwealth Online"
              width="2783"
              height="685"
              decoding="async"
            />
          </a>

          <button
            class="site-nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="primary-navigation"
            aria-label="Open navigation"
          >
            <span class="site-nav-toggle__icon" aria-hidden="true">
              <span class="site-nav-toggle__line"></span>
              <span class="site-nav-toggle__line"></span>
              <span class="site-nav-toggle__line"></span>
            </span>
            <span class="site-nav-toggle__text">Menu</span>
          </button>

          <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation">
            <% navItems.filter((item) => item.key !== "account").forEach((item) => { %>
            <a
              href="<%= item.href %>"
              <% if (item.key === page.activeKey) { %>class="is-active" aria-current="page"<% } %>
              <% if (item.external) { %>target="_blank" rel="noopener noreferrer"<% } %>
            ><%= item.label %></a>
            <% }) %>
            <a class="site-nav__donate" href="https://ko-fi.com/commonwealth_online" target="_blank" rel="noopener noreferrer">Donate</a>
            <a
              href="/account"
              class="site-nav__account<%= page.activeKey === "account" ? " is-active" : "" %>"
              <% if (page.activeKey === "account") { %>aria-current="page"<% } %>
              data-account-nav
              aria-label="Login or sign up"
            >
              <span class="site-nav__account-label" data-account-nav-label>Login / Sign Up</span>
              <img
                class="site-nav__profile-avatar"
                data-account-nav-avatar
                src="/assets/profile-icons/armorer.png"
                alt=""
                width="32"
                height="32"
                hidden
              />
            </a>
          </nav>
        </div>
      </header>
