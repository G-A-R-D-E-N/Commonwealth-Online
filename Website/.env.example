# Copy to .env and adjust. All values have safe defaults for local development.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Public origin, used for absolute URLs (no trailing slash)
SITE_URL=http://localhost:3000
# Set to true behind nginx/Cloudflare so client IPs are read correctly
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
# SQLite file path, relative to the project root.
DATABASE_PATH=data/commonwealth-online.sqlite

# --- Supabase public browser configuration ----------------------------------
# Safe to expose to the browser. Never put a Supabase secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Feature scaffolding ----------------------------------------------------
# Flip to true once the feature is ready to appear in the navigation.
FEATURE_FORUM=false
# Apply is live; set false to hide the nav link (forms stay at /apply).
FEATURE_APPLICATIONS=true

# --- Applications -> Discord -------------------------------------------------
# The bot creates one post per application in this private Discord forum channel.
DISCORD_BOT_TOKEN=
# The server the bot checks before enabling applications.
DISCORD_GUILD_ID=
# Use this one forum for both application types, or override either type below.
DISCORD_APPLICATIONS_FORUM_CHANNEL_ID=
DISCORD_TEAM_APPLICATIONS_FORUM_CHANNEL_ID=
DISCORD_BETA_APPLICATIONS_FORUM_CHANNEL_ID=
# Only members with this role can approve, reject, or request more information.
DISCORD_APPLICATION_REVIEWER_ROLE_ID=
# The applicable role is assigned when that application type is approved.
DISCORD_TEAM_ROLE_ID=
DISCORD_BETA_ROLE_ID=

# --- Applications -> Mailcow -------------------------------------------------
# Used only for More Information emails sent to applicants.
MAILCOW_SMTP_HOST=
MAILCOW_SMTP_PORT=465
MAILCOW_SMTP_SECURE=true
MAILCOW_SMTP_USER=
MAILCOW_SMTP_PASSWORD=
MAILCOW_FROM=
# Shared secret required by GET /api/v1/applications (admin/bot reads).
ADMIN_TOKEN=

# --- Gitea integration ------------------------------------------------------
# Used by the server side helpers; the browser code keeps its own copy in
# static/js/repo.js and static/js/updates.js.
GITEA_BASE=https://git.zambazosmedia.group
GITEA_OWNER=Commonwealth-Online
GITEA_REPO=Commonwealth-Online-Public
